# Copy to .env and fill in. .env is gitignored -- never commit real values.

# --- DagsHub: hosted MLflow tracking + DVC remote -------------------------
MLFLOW_TRACKING_URI=https://dagshub.com/<user>/<repo>.mlflow
MLFLOW_TRACKING_USERNAME=<dagshub-username>
MLFLOW_TRACKING_PASSWORD=<dagshub-token>

# --- Supabase: hot serving store -----------------------------------------
# Session pooler connection string from Project Settings -> Database.
DATABASE_URL=postgresql://postgres.<ref>:<password>@<host>:5432/postgres
SUPABASE_URL=https://<ref>.supabase.co
SUPABASE_SERVICE_KEY=<service-role-key>

# --- Serving -------------------------------------------------------------
# Which MLflow stage/tag the API loads at startup.
MODEL_STAGE=Production
# Rolling window the retention job keeps in the hot store.
HOT_STORE_RETENTION_DAYS=30
