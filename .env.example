# Copy to .env and fill in. .env is gitignored -- never commit real values.

# --- DagsHub: hosted MLflow tracking -------------------------------------
# MLflow ONLY. DagsHub is deliberately NOT the DVC remote (decision 10) --
# that is Cloudflare R2, below.
MLFLOW_TRACKING_URI=https://dagshub.com/<user>/<repo>.mlflow
MLFLOW_TRACKING_USERNAME=<dagshub-username>
MLFLOW_TRACKING_PASSWORD=<dagshub-token>

# --- Supabase: hot serving store -----------------------------------------
# A direct Postgres connection is all we use -- no PostgREST, no Auth, no
# Storage, no SDK -- so the anon/service-role keys are deliberately absent.
# Connection string from Project Settings -> Database. Prefer the session
# pooler; if you switch to the transaction pooler (port 6543), check
# psycopg's prepared statements first (see ARCHITECTURE section 7).
DATABASE_URL=postgresql://postgres.<ref>:<password>@<host>:5432/postgres

# --- Cloudflare R2: the DVC remote ---------------------------------------
# S3-compatible, so `dvc[s3]` already covers it, and egress is free -- which
# is what matters when CI pulls a few GB per run (decision 10).
#
# Create in the Cloudflare dashboard: R2 -> Create bucket, then
# R2 -> Manage R2 API Tokens -> Create (Object Read & Write).
R2_ACCOUNT_ID=<cloudflare-account-id>
R2_BUCKET=<bucket-name>
R2_ACCESS_KEY_ID=<r2-access-key-id>
R2_SECRET_ACCESS_KEY=<r2-secret-access-key>
R2_ENDPOINT_URL=https://<cloudflare-account-id>.r2.cloudflarestorage.com
#
# LOCAL: DVC does not read these directly. Wire them once -- the endpoint and
# bucket go in .dvc/config (committed), the secrets go in .dvc/config.local
# (gitignored by .dvc/.gitignore, so they never reach git):
#
#   dvc remote add -d r2 s3://$R2_BUCKET/dvcstore
#   dvc remote modify r2 endpointurl $R2_ENDPOINT_URL
#   dvc remote modify r2 region auto
#   dvc remote modify --local r2 access_key_id     $R2_ACCESS_KEY_ID
#   dvc remote modify --local r2 secret_access_key $R2_SECRET_ACCESS_KEY
#
# CI: there is no .dvc/config.local on a runner. Put the two secrets in
# GitHub Actions secrets and export them under the AWS names, which s3fs
# picks up for any S3-compatible endpoint:
#
#   AWS_ACCESS_KEY_ID: ${{ secrets.R2_ACCESS_KEY_ID }}
#   AWS_SECRET_ACCESS_KEY: ${{ secrets.R2_SECRET_ACCESS_KEY }}

# --- Jobs ----------------------------------------------------------------
# Rolling window the retention job keeps in the hot store. Not read by any
# code yet -- prune_transaction_events() carries its own 30-day default until
# the Phase 6 jobs container passes this in.
HOT_STORE_RETENTION_DAYS=30
